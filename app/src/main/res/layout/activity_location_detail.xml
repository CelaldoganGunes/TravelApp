<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Konum Başlığı -->
        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"
            android:gravity="center_horizontal" />

        <!-- İl ve İlçe Bilgisi -->
        <TextView
            android:id="@+id/tvDetailCityDistrict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="City, District"
            android:textSize="18sp"
            android:gravity="center_horizontal"
            android:paddingBottom="16dp" />

        <!-- Fotoğraf Galerisi -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/galleryViewPager"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp" />

        <!-- Açıklama Metni -->
        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description goes here."
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <!-- Google Maps Fragment -->
        <FrameLayout
            android:id="@+id/mapFragment"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabDirections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:contentDescription="Get Directions"
            android:src="@drawable/ic_directions"
            android:tint="@android:color/white"
            app:backgroundTint="@color/purple_500" />

        <!-- Yorum Yapma Alanı -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adınız" />

        <EditText
            android:id="@+id/etRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Puan (1-5)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Yorumunuz" />

        <Button
            android:id="@+id/btnSubmitComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yorumu Gönder" />

        <!-- Yorumlar Listesi -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
